{
  "version": "3.2.9",
  "license": "MIT",
  "name": "@dooherceg/material-react-table",
  "description": "A fully featured Material UI V6 implementation of TanStack React Table V8, written from the ground up in TypeScript.",
  "author": "HercegDoo",
  "keywords": [],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HercegDoo/material-react-table.git"
  },
  "homepage": "https://www.material-react-table.com/",
  "bugs": {
    "url": "https://github.com/HercegDoo/material-react-table/issues"
  },
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "typings": "dist/index.d.ts",
  "files": [
    "dist",
    "locales"
  ],
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "190 kB"
    },
    {
      "path": "dist/index.esm.js",
      "limit": "150 kB"
    }
  ],
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "build": "pnpm lib:build",
    "build-locales": "pnpm lib:build-locales",
    "build-lib": "pnpm lib:build-lib",
    "dev": "pnpm lib:dev",
    "lib:build": "pnpm build-lib && pnpm build-locales",
    "lib:build-locales": "node build-locales.mjs",
    "lib:build-lib": "node -e \"require('fs').rmSync('dist', {recursive:true,force:true})\" && rollup -c rollup.config.mjs && size-limit",
    "lib:dev": "rollup -c rollup.config.mjs --watch",
    "lint": "eslint . --config eslint.config.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "size": "size-limit",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "storybook:dev": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@eslint/js": "^9.17.0",
    "@faker-js/faker": "^9.3.0",
    "@iconify/react": "^6.0.2",
    "@mui/icons-material": "^7.3.5",
    "@mui/material": "^7.3.5",
    "@mui/x-date-pickers": "^8.27.0",
    "@rollup/plugin-typescript": "^11.1.6",
    "@size-limit/preset-small-lib": "^11.1.6",
    "@storybook/addon-a11y": "^10.3.5",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/addon-links": "^10.3.5",
    "@storybook/blocks": "^8.6.14",
    "@storybook/preview-api": "^8.6.14",
    "@storybook/react": "^10.3.5",
    "@storybook/react-vite": "^10.3.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/lodash": "^4.17.24",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@typescript-eslint/eslint-plugin": "8.18.1",
    "@typescript-eslint/parser": "8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/ui": "^4.1.5",
    "eslint": "^9.17.0",
    "eslint-plugin-mui-path-imports": "^0.0.15",
    "eslint-plugin-perfectionist": "^4.4.0",
    "eslint-plugin-storybook": "^10.3.5",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.6.0",
    "jsdom": "^29.1.0",
    "print-js": "^1.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.74.0",
    "react-is": "^19.0.0",
    "rollup": "^3.30.0",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-delete": "^2.1.0",
    "rollup-plugin-dts": "^6.1.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "size-limit": "^11.1.6",
    "storybook": "^10.3.5",
    "storybook-dark-mode": "^5.0.0",
    "tslib": "^2.8.1",
    "typescript": "5.7.2",
    "vite": "^7.3.2",
    "vitest": "^4.1.5",
    "@dooherceg/mui-date-range-picker": "^0.2.8"
  },
  "peerDependencies": {
    "@emotion/react": ">=11.13",
    "@emotion/styled": ">=11.13",
    "@iconify/react": ">=6",
    "@mui/icons-material": ">=7",
    "@mui/material": ">=7",
    "@mui/x-date-pickers": ">=8",
    "print-js": ">=1.6",
    "react": ">=18.0",
    "react-dom": ">=18.0",
    "react-hook-form": ">=7.0",
    "@dooherceg/mui-date-range-picker": "^0.2.8"
  },
  "dependencies": {
    "@tanstack/match-sorter-utils": "8.19.4",
    "@tanstack/react-table": "8.20.6",
    "@tanstack/react-virtual": "3.11.2",
    "dayjs": "^1.11.13",
    "highlight-words": "2.0.0",
    "lodash": "^4.18.1",
    "notistack": "^3.0.2",
    "use-debounce": "^10.1.1"
  }
}
